{
  "name": "imnotanagent",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // The bounce videos are only handed out by the Worker (src/bounce.js); a request for one
  // by its file name reaches the Worker first, which has no such route and answers 404.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/bounce-videos/*"] },
  // Records which challenges have been answered and how often each IP has failed.
  // `wrangler dev` uses a local copy; the id is the deployed namespace.
  "kv_namespaces": [{ "binding": "USED", "id": "58448160aae74b4aa57e86406fb227a2" }],
  "vars": {
    // "true" returns answers and raw measurements with each result, for tuning. It hands a bot
    // the answer key, so keep it "false" here; to tune locally, add DEBUG_FEATURES=true to .dev.vars.
    "DEBUG_FEATURES": "false"
  }
}
