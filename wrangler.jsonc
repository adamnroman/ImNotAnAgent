{
  "name": "ball-captcha",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  // Records which sessions have been scored. Before deploying, create the namespace with
  // `npx wrangler kv namespace create USED` and add the id it prints here.
  "kv_namespaces": [{ "binding": "USED" }],
  "vars": {
    // "true" returns answers and raw measurements with each result, for tuning. It hands a bot
    // the answer key, so keep it "false" here; to tune locally, add DEBUG_FEATURES=true to .dev.vars.
    "DEBUG_FEATURES": "false"
  }
}
